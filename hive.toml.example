# model = "qwen3-coder-next:cloud"
# base_url = "http://localhost:11434"

[resource_limits]
# TODO: Define maximum concurrent pods and resource budgets
# max_pods = 8
# memory_mb = 4096
# token_budget_per_cycle = 100000

[[pod_types]]
# TODO: Define built-in or custom pod types
# name = "planner"
